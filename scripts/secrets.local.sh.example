# OpenSky API credentials for running the flight engine by hand.
#
#   cp scripts/secrets.local.sh.example scripts/secrets.local.sh
#   # paste your real client id/secret into the copy, then:
#   set -a; source scripts/secrets.local.sh; set +a
#   python scripts/fetch_flights.py
#
# scripts/secrets.local.sh is git-ignored, so the real values never get committed.
# The GitHub Action does NOT use this file — it reads the same two values from
# repo secrets (OPENSKY_CLIENT_ID / OPENSKY_CLIENT_SECRET).

export OPENSKY_CLIENT_ID="paste-your-client-id-here"
export OPENSKY_CLIENT_SECRET="paste-your-client-secret-here"
